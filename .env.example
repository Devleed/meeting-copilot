OPENAI_API_KEY=
COHERE_API_KEY=

# --- transcribe.py tuning ---
BLACKHOLE_DEVICE_INDEX=1
SAMPLE_RATE=16000
MODEL_SIZE=base
VAD_CHUNK_SIZE=512
SILENCE_THRESHOLD=4.0
SPEECH_PROBABILITY_THRESHOLD=0.2
MIN_UTTERANCE_SECONDS=1.0
FLUSH_WAIT_SECONDS=4.0
MODE=auto

# --- embedder.py tuning ---
EMBEDDER_ENCODING=cl100k_base
EMBEDDER_TOKEN_THRESHOLD=4000
EMBEDDER_TARGET_CHUNK_TOKENS=400
EMBEDDER_OVERLAP_TOKENS=50
EMBEDDER_EMBED_MODEL=text-embedding-3-small
EMBEDDER_EMBED_DIM=1536
EMBEDDER_COLLECTION_NAME=context_chunks
