LLM_PROVIDER=openai
# Supported: openai
# ANTHROPIC_API_KEY=sk-ant-...

# Required: OpenAI API key used for GPT-4o suggestions and text embeddings
OPENAI_API_KEY=
# (OPTIONAL) Required for RAG reranking: Cohere API key used to rerank retrieved context chunks
COHERE_API_KEY=

# --- transcribe.py tuning ---
# Audio capture. The default keeps the existing BlackHole/PulseAudio setup.
# Set both values to capture one desktop application with PocketStation.
# CAPTURE_BACKEND=pocketstation
# CAPTURE_APPLICATION=Zoom
# sounddevice index of the BlackHole 2ch virtual audio device (find with: python3 -c "import sounddevice; print(sounddevice.query_devices())")
BLACKHOLE_DEVICE_INDEX=1
# Audio sample rate in Hz — must match Silero VAD's expected rate (16000)
SAMPLE_RATE=16000
# Whisper model size: tiny, base, small, medium, large — larger = more accurate but slower
MODEL_SIZE=base
# Number of audio samples per VAD chunk — Silero VAD requires exactly 512 at 16kHz
VAD_CHUNK_SIZE=512
# Seconds of silence after speech before the utterance is committed for transcription
# Longer values allow for more natural pauses but increase latency before transcription starts
# Shorter values may cut off the end of speech but provide faster feedback
SILENCE_THRESHOLD=4.0
# VAD speech probability cutoff — lower values catch quieter/softer speech (range: 0.0–1.0)
SPEECH_PROBABILITY_THRESHOLD=0.2
# Minimum duration of detected speech (seconds) required to trigger transcription
# 
MIN_UTTERANCE_SECONDS=1.0
# Seconds to wait after the last transcribed segment before sending buffered text to OpenAI
# Longer values allow for more natural pauses but increase latency before suggestions are generated
# Shorter values provide faster suggestions but may cut off the end of speech or generate suggestions too early
FLUSH_WAIT_SECONDS=4.0
# Whisper compute device — "auto" picks MPS on Apple Silicon, falls back to CPU
MODE=auto

# --- embedder.py tuning ---
# tiktoken encoding used to count tokens when splitting context documents
EMBEDDER_ENCODING=cl100k_base
# Documents with fewer tokens than this are embedded as a single chunk without splitting
EMBEDDER_TOKEN_THRESHOLD=4000
# Target token count per chunk when splitting large documents
EMBEDDER_TARGET_CHUNK_TOKENS=400
# Number of tokens of overlap between consecutive chunks to preserve context across boundaries
EMBEDDER_OVERLAP_TOKENS=50
# OpenAI embedding model used to vectorize chunks
EMBEDDER_EMBED_MODEL=text-embedding-3-small
# Dimensionality of the embedding vectors — must match the model's output size
EMBEDDER_EMBED_DIM=1536
# Qdrant collection name where embedded context chunks are stored
EMBEDDER_COLLECTION_NAME=context_chunks
